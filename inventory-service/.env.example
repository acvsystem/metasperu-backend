NODE_ENV=production
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=inventory_app
DB_PASSWORD=replace-locally
DB_NAME=metasperu_bd
# Same independent random secret in auth-service and inventory-service (64+ characters).
INVENTORY_JWT_SECRET=
# Comma-separated EXACT origins; include the real production frontend and local QA only when needed.
CORS_ORIGINS=https://inventory.example.com
# Set only if behind a known trusted reverse proxy. Never trust arbitrary forwarded headers.
TRUST_PROXY_HOPS=0
# Separate secret for short-lived per-store importer tokens.
INVENTORY_IMPORT_SECRET=

