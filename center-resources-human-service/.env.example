NODE_ENV=production
HOST=127.0.0.1
PORT=3004
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=center_service
DB_PASSWORD=replace-locally
DB_NAME=bd_metasperu
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
# Separate payroll/HR source. Use a dedicated account with only the required access.
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=3306
DEV_DB_USER=center_hr_source
DEV_DB_PASSWORD=replace-locally
DEV_DB_NAME=bd_metasperu
# Generate a private random secret of at least 64 characters; share only between Center services.
CENTER_JWT_SECRET=
CORS_ORIGINS=https://metasperu.net.pe
TRUST_PROXY_HOPS=1
ENABLE_SCHEDULED_JOBS=false
AMQP_URL=amqp://replace-locally
RECORDING_RETENTION_DAYS=30
