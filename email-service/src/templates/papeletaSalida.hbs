<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Papeleta Permiso de Salida</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            color: #333;
            margin: 0;
            padding: 20px;
            background-color: #fff;
        }
        .container {
            max-width: 750px;
            margin: 0 auto;
            border: 1px solid #e0e0e0;
            padding: 25px;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
        }
        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 3px solid #004080;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .logo-section {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .logo-box {
            background-color: #004080;
            color: white;
            font-weight: bold;
            font-size: 18px;
            padding: 8px 12px;
            border-radius: 4px;
        }
        .logo-text {
            font-size: 14px;
            font-weight: bold;
            color: #004080;
            line-height: 1.2;
        }
        .title-section {
            text-align: center;
            flex-grow: 1;
            font-size: 16px;
            font-weight: bold;
            color: #333;
            margin-top: 5px;
        }
        .nro-papeleta {
            text-align: right;
        }
        .nro-papeleta span:first-child {
            font-size: 11px;
            color: #666;
            display: block;
        }
        .nro-papeleta span:last-child {
            font-size: 16px;
            font-weight: bold;
            color: #004080;
        }

        /* Form Fields */
        .field-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }
        .field-group {
            flex: 1;
            margin-right: 20px;
        }
        .field-group:last-child {
            margin-right: 0;
        }
        .field-label {
            font-size: 10px;
            color: #777;
            text-transform: uppercase;
            font-weight: bold;
            margin-bottom: 3px;
        }
        .field-value {
            font-size: 14px;
            color: #222;
            border-bottom: 1px solid #ddd;
            padding-bottom: 4px;
        }

        /* Info Box */
        .info-box {
            background-color: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 6px;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 20px 0;
        }
        .time-details div {
            margin-bottom: 6px;
            font-size: 13px;
        }
        .time-details span {
            font-weight: bold;
            color: #444;
            display: inline-block;
            width: 55px;
        }
        .total-hours-card {
            border: 2px dashed #004080;
            border-radius: 8px;
            padding: 10px 20px;
            text-align: center;
            background: #fff;
        }
        .total-hours-card .label {
            font-size: 11px;
            color: #004080;
            font-weight: bold;
            margin-bottom: 3px;
        }
        .total-hours-card .value {
            font-size: 22px;
            font-weight: bold;
            color: #004080;
        }

        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            margin-bottom: 35px;
        }
        th {
            background-color: #333;
            color: white;
            font-size: 11px;
            text-transform: uppercase;
            padding: 8px;
            text-align: center;
            font-weight: normal;
        }
        td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center;
            font-size: 13px;
            color: #333;
        }
        tr:nth-child(even) {
            background-color: #fdfdfd;
        }

        /* Signatures */
        .signatures {
            display: flex;
            justify-content: space-around;
            margin-top: 50px;
            text-align: center;
        }
        .signature-line {
            width: 250px;
            border-top: 1px solid #333;
            padding-top: 5px;
            font-size: 12px;
            color: #444;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Header -->
    <div class="header">
        <div class="logo-section">
            <div class="logo-box">M</div>
            <div class="logo-text">METAS<br>PERÚ SAC</div>
        </div>
        <div class="title-section">
            PAPELETA PERMISO DE SALIDA
        </div>
        <div class="nro-papeleta">
            <span>Nro. Papeleta</span>
            <span>{{nroPapeleta}}</span>
        </div>
    </div>

    <!-- Colaborador -->
    <div class="field-row">
        <div class="field-group">
            <div class="field-label">Apellidos y Nombre</div>
            <div class="field-value">{{empleado}}</div>
        </div>
    </div>

    <!-- Fecha Solicitud / Cargo -->
    <div class="field-row">
        <div class="field-group">
            <div class="field-label">Fecha Solicitud</div>
            <div class="field-value">{{fechaSolicitud}}</div>
        </div>
        <div class="field-group">
            <div class="field-label">Cargo</div>
            <div class="field-value">{{cargo}}</div>
        </div>
    </div>

    <!-- Unidad de Servicio / Tipo Papeleta -->
    <div class="field-row">
        <div class="field-group">
            <div class="field-label">Unidad de Servicio</div>
            <div class="field-value">{{unidadServicio}}</div>
        </div>
        <div class="field-group">
            <div class="field-label">Tipo Papeleta</div>
            <div class="field-value">{{tipoPapeleta}}</div>
        </div>
    </div>

    <!-- Cuadro de Horas -->
    <div class="info-box">
        <div class="time-details">
            <div><span>Desde:</span> {{desde}} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <span>Salida:</span> {{salida}}</div>
            <div><span>Hasta:</span> {{hasta}} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <span>Llegada:</span> {{llegada}}</div>
        </div>
        <div class="total-hours-card">
            <div class="label">Horas Solicitadas</div>
            <div class="value">{{horasSolicitadas}}</div>
        </div>
    </div>

    <!-- Tabla de Compensaciones -->
    <table>
        <thead>
            <tr>
                <th>Fecha Compensación</th>
                <th>Hora Extra Acum.</th>
                <th>Hora Solicitada</th>
                <th>Hora Sobrante</th>
            </tr>
        </thead>
        <tbody>
            {{#each compensaciones}}
            <tr>
                <td>{{fechaCompensacion}}</td>
                <td>{{horaExtraAcum}}</td>
                <td>{{horaSolicitada}}</td>
                <td>{{horaSobrante}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <!-- Firmas -->
    <div class="signatures">
        <div class="signature-line">
            Firma del Colaborador
        </div>
        <div class="signature-line">
            V°B° Jefe Inmediato
        </div>
    </div>
</div>

</body>
</html>