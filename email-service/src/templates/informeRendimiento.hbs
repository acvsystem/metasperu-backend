<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Informe de Rendimiento</title>
  <!--[if mso]>
  <style type="text/css">
    body, table, td { font-family: Arial, Helvetica, sans-serif !important; }
  </style>
  <![endif]-->
</head>
<body style="margin:0; padding:0; background-color:#eef2f7; font-family:Arial, Helvetica, sans-serif; color:#333333;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef2f7; padding:32px 12px;">
    <tr>
      <td align="center">

        <!-- Card -->
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="max-width:560px; width:100%; background-color:#ffffff; border-radius:10px; overflow:hidden; box-shadow:0 4px 16px rgba(0,0,0,0.08);">

          <!-- Header -->
          <tr>
            <td align="center" style="background-color:#0052a3; padding:22px 28px;">
              <h1 style="margin:0; font-size:20px; font-weight:700; color:#ffffff; letter-spacing:0.5px;">
                METAS PERÚ S.A.C
              </h1>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:28px 28px 8px;">
              <p style="margin:0 0 22px; font-size:15px; line-height:1.55; color:#4a5568; text-align:center;">
                Hola, se ha generado el <strong style="color:#1a202c;">Informe de Rendimiento</strong> consolidado de tiendas.
              </p>

              <!-- Summary table header -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; margin-bottom:4px;">
                <tr style="background-color:#f0f4f8;">
                  <td style="padding:10px 14px; font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.4px; border-radius:6px 0 0 0;">
                    Concepto
                  </td>
                  <td align="right" style="padding:10px 14px; font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.4px; border-radius:0 6px 0 0;">
                    Valor
                  </td>
                </tr>

                <tr>
                  <td style="padding:12px 14px; font-size:14px; color:#4a5568; border-bottom:1px solid #edf2f7;">
                    Fecha desde
                  </td>
                  <td align="right" style="padding:12px 14px; font-size:14px; font-weight:600; color:#1a202c; border-bottom:1px solid #edf2f7;">
                    {{fechaDesde}}
                  </td>
                </tr>

                <tr>
                  <td style="padding:12px 14px; font-size:14px; color:#4a5568; border-bottom:1px solid #edf2f7;">
                    Fecha hasta
                  </td>
                  <td align="right" style="padding:12px 14px; font-size:14px; font-weight:600; color:#1a202c; border-bottom:1px solid #edf2f7;">
                    {{fechaHasta}}
                  </td>
                </tr>

                <tr>
                  <td style="padding:12px 14px; font-size:14px; color:#4a5568; border-bottom:1px solid #edf2f7;">
                    Tiendas en catálogo
                  </td>
                  <td align="right" style="padding:12px 14px; font-size:14px; font-weight:600; color:#1a202c; border-bottom:1px solid #edf2f7;">
                    {{tiendasCatalogo}}
                  </td>
                </tr>

                <tr>
                  <td style="padding:12px 14px; font-size:14px; color:#4a5568;">
                    Tiendas que respondieron
                  </td>
                  <td align="right" style="padding:12px 14px; font-size:14px; font-weight:700; color:#0052a3;">
                    {{tiendasRespondieron}}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Note box -->
          <tr>
            <td style="padding:12px 28px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="background-color:#fffbeb; border:1px solid #fde68a; border-radius:6px; padding:12px 14px;">
                    <p style="margin:0; font-size:13px; line-height:1.5; color:#92400e;">
                      <strong>Adjunto:</strong> Excel con ventas diarias (S/ y $), unidades y stock por tienda.
                      Las tiendas sin respuesta aparecen con celdas vacías.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA button -->
          <tr>
            <td align="center" style="padding:24px 28px 32px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="background-color:#0052a3; border-radius:6px;">
                    <span style="display:inline-block; padding:12px 28px; font-size:14px; font-weight:700; color:#ffffff; text-decoration:none;">
                      Informe adjunto en este correo
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
        <!-- /Card -->

        <!-- Footer outside card -->
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="max-width:560px; width:100%;">
          <tr>
            <td align="center" style="padding:18px 12px 0; font-size:12px; color:#94a3b8; line-height:1.5;">
              Este correo fue generado automáticamente por Center Service.<br />
              No responder a este mensaje.
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>

</body>
</html>
