NODE_ENV=production
HOST=127.0.0.1
PORT=3002
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=center_service
DB_PASSWORD=replace-locally
DB_NAME=bd_metasperu
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
# Generate a private random secret of at least 64 characters; share only between Center services.
CENTER_JWT_SECRET=
CORS_ORIGINS=https://metasperu.net.pe
TRUST_PROXY_HOPS=1
ENABLE_SCHEDULED_JOBS=false
AMQP_URL=amqp://replace-locally
RECORDING_RETENTION_DAYS=30

ENABLE_RECORDING_RETENTION=false

EXPORTS_ENABLED=false
ENABLE_EXPORT_WORKER=false
# Absolute private directory shared by HTTP and its export worker; never serve it as static content.
CENTER_EXPORT_DIR=/var/lib/metasperu-center/exports
